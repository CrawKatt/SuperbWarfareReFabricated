{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.atsuishio.superbwarfare.Mod"
    ],
    "client": [
      "com.atsuishio.superbwarfare.ClientMod"
    ]
  },
  "mixins": [
    "mixins.superbwarfare.json"
  ],
  "accessWidener": "superbwarfare.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=17",
    "geckolib": ">=4.4.6",
    "trinkets": ">=3.7.2"
  },
  "recommends": {
    "patchouli": "*",
    "jei": "*"
  },
  "suggests": {
    "cloth-config": "*"
  },
  "breaks": {
    "optifabric": "*"
  }
}
