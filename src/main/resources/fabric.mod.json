{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "sources": "https://github.com/CrawKatt/SuperbWarfareReFabricated"
  },
  "license": "${mod_license}",
  "icon": "logo.png",
  "accessWidener": "superbwarfare.accesswidener",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.atsuishio.superbwarfare.Mod"
    ],
    "client": [
      "com.atsuishio.superbwarfare.client.SuperbWarfareFabricClient"
    ],
    "fabric-datagen": [
      "com.atsuishio.superbwarfare.datagen.DataGenerators"
    ],
    "cardinal-components": [
      "com.atsuishio.superbwarfare.init.ModComponents"
    ]
  },
  "custom": {
    "cardinal-components": [
      "superbwarfare:player_variable",
      "superbwarfare:phosphorus_fire_capability"
    ]
  },
  "mixins": [
    "superbwarfare.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.9",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "geckolib": "*",
    "cloth-config": "*",
    "forgeconfigapiport": "*",
    "extensibleenums": "*",
    "trinkets": "*",
    "mkb": "*"
  },
  "suggests": {
    "jei": "*",
    "jade": "*",
    "patchouli": "*",
    "realcamera": "*",
    "thermoo": "*",
    "scorchful": "*",
    "frostiful": "*",
    "ponder": "*",
    "sable": "*"
  }
}
